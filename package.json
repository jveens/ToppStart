{
  "name": "toppstart",
  "version": "1.0.0",
  "scripts": {
    "build:scss": "sass --style=expanded --source-map src/scss/style.scss build/css/style.css && sass --style=expanded --source-map src/scss/admin.scss build/css/admin.css && postcss build/css/*.css --use autoprefixer -d build/css",
    "build:js": "esbuild src/js/main.js --bundle --minify --sourcemap --outfile=build/js/main.js && esbuild src/js/admin.js --bundle --minify --sourcemap --outfile=build/js/admin.js",
    "watch:scss": "sass --watch src/scss/style.scss:build/css/style.css src/scss/admin.scss:build/css/admin.css --style=expanded --source-map",
    "watch:js": "esbuild src/js/main.js --bundle --minify --sourcemap --outfile=build/js/main.js --watch && esbuild src/js/admin.js --bundle --minify --sourcemap --outfile=build/js/admin.js --watch",
    "build": "npm run build:scss && npm run build:js",
    "watch": "npm-run-all --parallel watch:scss watch:js",
    "browser-sync": "browser-sync start --config bs-config.cjs",
    "dev": "npm-run-all --parallel watch browser-sync",
    "lint:scss": "stylelint 'src/scss/**/*.scss'",
    "lint:js": "eslint 'src/js/**/*.js'",
    "format": "prettier --write '**/*.{js,scss,json,md}'",
    "open:browser": "open http://localhost:3000"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.1",
    "@eslint/json": "^0.12.0",
    "autoprefixer": "^10.4.21",
    "browser-sync": "^2.29.3",
    "dotenv": "^16.5.0",
    "esbuild": "^0.20.0",
    "eslint": "^9.25.1",
    "globals": "^16.0.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.3",
    "postcss-cli": "^10.1.0",
    "prettier": "^3.5.3",
    "sass": "^1.87.0",
    "stylelint": "^16.19.1",
    "stylelint-config-standard-scss": "^14.0.0"
  }
}
